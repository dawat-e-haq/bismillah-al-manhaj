<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bismillah Al-Manhaj</title>
    <style>
        body { background-color: #f0fff4; text-align: center; font-family: Arial; padding: 20px; }
        h1 { color: #065f46; font-size: 28px; }
        button { background-color: #065f46; color: white; border: none; padding: 15px 25px; margin: 10px; border-radius: 10px; font-size: 16px; cursor: pointer; }
        button:hover { background-color: #047857; }
        #result { background: white; padding: 20px; margin-top: 20px; border-radius: 10px; font-size: 18px; }
    </style>
</head>
<body>
    <h1>بسم الله المنهج 📖</h1>
    
    <button onclick="showQuran()">Random Quran</button>
    <button onclick="showHadees()">Random Hadees</button>
    <button onclick="showDua()">Random Dua</button>
    
    <div id="result">Button dabayein</div>
    
    <script>
        const quran = ["Bismillah hir Rahman nir Raheem", "Allah har cheez par qadir hai"];
        const hadees = ["Muslim ki khair me hai", "Neki karo aur dariya me daal do"];
        const dua = ["Rabbi zidni ilma", "Allahumma inni as'alukal afiyah"];
        
        function showQuran() { document.getElementById("result").innerText = quran[Math.floor(Math.random()*quran.length)]; }
        function showHadees() { document.getElementById("result").innerText = hadees[Math.floor(Math.random()*hadees.length)]; }
        function showDua() { document.getElementById("result").innerText = dua[Math.floor(Math.random()*dua.length)]; }
    </script>
</body>
</html>
